# Линейлік іздеу
def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1


# Бинарлық іздеу
def binary_search(arr, target):
    left = 0
    right = len(arr) - 1

    while left <= right:
        mid = (left + right) // 2

        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid - 1

    return -1


# Тест
arr = [1, 3, 5, 7, 9, 11]
target = 7

print("Linear:", linear_search(arr, target))
print("Binary:", binary_search(arr, target))
